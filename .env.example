# =============================================================================
# LunAcedia — Information infrastructure for the Lun ecosystem
# Copy this file to .env and fill in the values
# =============================================================================

# =============================================================================
# SERVER
# =============================================================================
PORT=4000
HTTP_PORT=4001

# Bearer token for client authentication (leave empty to disable — LAN only)
ACEDIA_SECRET=

# Where persisted state lives (action tiers, email classification rules, Google OAuth
# tokens, FCM device token) — default: ~/.lunacedia
# STORAGE_DIR=/data/lunacedia

# Encrypts google_tokens.json at rest — off by default, fail-closed: turning this on without a
# configured key refuses to start rather than fall back to writing refresh tokens in clear text. A pre-existing plaintext file still
# loads fine and gets re-encrypted transparently on the next write — no migration script.
# ACEDIA_TOKEN_ENCRYPTION_ENABLED=true
# ACEDIA_MASTER_KEY_FILE takes priority over ACEDIA_MASTER_KEY when both are set (so the key
# can be mounted from outside the volume it protects). Generate with: openssl rand -hex 32
# ACEDIA_MASTER_KEY=
# ACEDIA_MASTER_KEY_FILE=

# =============================================================================
# AI BUTLER (optional)
# =============================================================================
# AI_PROVIDER: none (default) | openai | ollama
# Lun'Acedia always keeps its own model for its own perimeter; a hub delegates to its agent,
# never the other way around.
# Can also be configured from the dashboard's onboarding banner (POST /api/config/ai-provider)
# instead of editing this file — takes effect immediately, no restart needed.
AI_PROVIDER=none

# openai — requires OPENAI_API_KEY
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# ollama — local LLM
# OLLAMA_URL=http://localhost:11434
# AI_MODEL=llama3.2

# =============================================================================
# PUSH NOTIFICATIONS — Firebase Cloud Messaging (optional)
# =============================================================================
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_SERVICE_ACCOUNT_KEY=<base64 of service account JSON>
# Priority levels that trigger FCM push (comma-separated: urgent,normal,info)
# ACEDIA_FCM_FILTER=urgent,normal

# =============================================================================
# GITHUB
# =============================================================================
# GITHUB_TOKEN should come from a dedicated "bot" GitHub account, not your own: a leaked token
# then doesn't compromise your own GitHub identity, and every comment/label/merge is visibly
# attributed to the bot, not to you.
# Personal Access Token (classic) scopes needed: `repo` (private repos) or `public_repo`
# (public only), plus `notifications`. For a private watched repo, the bot account must also
# be added as a collaborator (a token alone doesn't grant access) — invite it from the repo's
# Settings → Collaborators, same as any other GitHub account.
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_WATCHED_REPOS=*
GITHUB_EXCLUDE_REPOS=[]
GITHUB_POLL_INTERVAL_SEC=120

# =============================================================================
# EMAIL — Gmail via OAuth2
# =============================================================================
# Setup guide: see "Google OAuth setup" section in README.md
# All three Google connectors (Gmail, GCal, GTasks) share the same OAuth app
# and can use the same Client ID / Client Secret / refresh token.
#
# Required only for the in-app "Connect" flow (dashboard -> Réglages -> Connecter,
# GET /api/oauth/google/start) — leave unset if you only ever paste refresh tokens
# by hand (the OAuth Playground / manual method below).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Override the OAuth callback's base URL — only needed behind a reverse proxy or a
# non-default host/port; otherwise it's inferred from the request that reached
# /api/oauth/google/start.
# OAUTH_REDIRECT_BASE_URL=http://localhost:4001
# =============================================================================
# Name the mobile app (LunAvaritia) shows for this assistant — GET /api/identity. Default: LunAcedia.
# ASSISTANT_NAME=LunAcedia
# Optional per-model price overrides for the LLM spend report, JSON: {"model":[input,output]} in $ per
# million tokens. Spend alerts are set in the dashboard (« Dépense LLM »); they warn, they never block.
# LLM_PRICES={"gpt-4o-mini":[0.15,0.6]}
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The box holds the whole inbox; a mail older than this is stored as backlog, never announced or pushed.
GMAIL_MAX_AGE_HOURS=24
# How many inbox mails are listed at most (paginated).
GMAIL_MAX_INBOX=500
GMAIL_POLL_INTERVAL_MIN=5
# If GitHub also notifies you by mail while the GitHub connector is on, drop those mails with a filter
# rule (dashboard or Core panel → Filters: sender is notifications@github.com) — otherwise each one
# arrives twice.
# A mail's priority: Gmail's « important » is normal, the rest info; then the guard rules (set_priority), then the VIP
# list (always urgent). GMAIL_RULES is no longer read: at the first start of 0.16.0 its entries become guard rules
# (see priority_migration.json in STORAGE_DIR) — remove it afterwards.

# =============================================================================
# CALENDAR — Google Calendar via OAuth2
# =============================================================================
GCAL_ENABLED=false
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
# Calendars to poll — JSON array of calendar IDs (default: primary)
# GCAL_CALENDARS='["primary","work@group.calendar.google.com"]'
GCAL_CALENDARS=["primary"]
# How far ahead to fetch upcoming events (hours)
GCAL_LOOKAHEAD_HOURS=24
GCAL_POLL_INTERVAL_MIN=15
# Default priority (floor) for all calendar events (urgent|normal|info)
GCAL_PRIORITY=normal
# An event starting within this many minutes always escalates to urgent, regardless
# of GCAL_PRIORITY above — 0 disables the escalation
GCAL_URGENT_WITHIN_MIN=15

# =============================================================================
# TASKS — Google Tasks via OAuth2
# =============================================================================
GTASKS_ENABLED=false
GTASKS_CLIENT_ID=
GTASKS_CLIENT_SECRET=
GTASKS_REFRESH_TOKEN=
# Task list to poll — "@default" for primary list
GTASKS_LIST_ID=@default
# Poll interval in minutes (min 5, default 15)
GTASKS_POLL_INTERVAL_MIN=15

# =============================================================================
# RSS
# =============================================================================
RSS_ENABLED=false
# FEEDS — simple URL array or rich config with label + priority
# RSS_FEEDS='["https://hnrss.org/frontpage", "https://lobste.rs/rss"]'
# RSS_FEEDS='[{"url":"https://hnrss.org/frontpage","label":"HN","priority":"info"}]'
RSS_FEEDS=[]
RSS_MAX_AGE_HOURS=24
RSS_POLL_INTERVAL_MIN=30
# RSS and Home Assistant items have no source object to follow: they leave the box after this many hours.
# INBOX_INFO_TTL_HOURS=72

# =============================================================================
# HOME ASSISTANT
# =============================================================================
HA_ENABLED=false
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<long-lived access token from HA profile page>
# HA_ENTITIES='["sensor.cpu_temp","binary_sensor.motion","light.living_room"]'
# HA_POLL_INTERVAL_MIN=1
# HA_PRIORITY=normal